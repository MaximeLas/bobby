# Bobby API Keys
# Copy this file to .env and fill in your keys

# Assembly AI - for real-time meeting transcription
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ElevenLabs - for Bobby's text-to-speech voice
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Discord - for Bobby as a Discord meeting participant (optional)
# Get these from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_CHANNEL_ID=your_text_channel_id_here
DISCORD_VOICE_CHANNEL_ID=your_voice_channel_id_here
