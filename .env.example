# Bobby API Keys
# Copy this file to .env and fill in your keys

# Assembly AI - for real-time meeting transcription
ASSEMBLYAI_API_KEY=your_assemblyai_key_here

# ElevenLabs - for Bobby's text-to-speech voice
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Discord - for Bobby as a Discord meeting participant (optional)
# Get these from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_server_id_here
DISCORD_CHANNEL_ID=your_text_channel_id_here
DISCORD_VOICE_CHANNEL_ID=your_voice_channel_id_here

# Dev-server URL the agent deploys to and reports in COMPLETE: lines (optional)
# Defaults to the sandbox Vite port. Set to http://localhost:3000 for Next.js.
# BOBBY_DEV_URL=http://localhost:5173

# Anthropic API - optional fast path for Bobby's conversational brain
# When set (and `uv sync --extra brain` installed), "Hey Bobby" answers use
# the API directly (~1-3s) instead of the claude CLI (~5-15s).
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Proactive suggestions - Bobby offers to build features he hears discussed
# Off by default; opt in per meeting. See bobby/suggestions.py.
# BOBBY_PROACTIVE=1

# Lean agent launches - ON by default: Bobby's headless agents skip the
# launching user's personal MCP servers/skills/settings (measured: ~59k wasted
# cache tokens + ~5s latency per launch without this). Set 0 to restore.
# BOBBY_LEAN_AGENT=1

# Hard per-run spend ceiling for agent launches (claude --max-budget-usd).
# Unset = no cap. Note: on a subscription login this is accounting, not billing.
# BOBBY_AGENT_MAX_BUDGET_USD=5

# Speaker labels in local wake-word mode - OFF by default. Adds [A]/[B]
# diarization labels (display-only; triggers unaffected) when two people share
# one mic. Name them via BOBBY_SPEAKER_NAMES or speaker_names.txt.
# BOBBY_SPEAKER_LABELS=1
# BOBBY_SPEAKER_NAMES=A=Max,B=David
